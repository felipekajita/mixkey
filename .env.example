# Copie para .env.local (local) ou cadastre em Vercel → Project → Settings → Environment Variables.
# Todas são opcionais: fontes sem chave são puladas automaticamente.

# Spotify — capas em alta + habilita a ReccoBeats (key/BPM/energia gratuitos)
# https://developer.spotify.com/dashboard → Create app → copie Client ID e Client Secret
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm — faixas similares e gêneros
# https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Google Custom Search (busca de imagens) — último recurso para capas
# https://programmablesearchengine.google.com (ative "Image search") + chave em console.cloud.google.com
# Atenção: a Google fechou esta API para novos clientes em 2025.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Link do repositório público (exigência da licença AGPL do Essentia.js) — aparece no rodapé
NEXT_PUBLIC_SOURCE_URL=

# "1" desliga os scrapers (Tunebat, GetSongKey, Beatport, YouTube Music)
DISABLE_SCRAPING=
